{
  "name": "@pluton/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsup",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "prisma generate && vitest run",
    "typecheck": "prisma generate && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "auth": "1.7.26",
    "tsup": "8.5.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@hono/zod-validator": "^0.9.1",
    "@pluton/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.26",
    "hono": "^4.13.19",
    "prisma": "7.10.1",
    "zod": "^4.6.7"
  }
}
